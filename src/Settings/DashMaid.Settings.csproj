<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>DashMaid.Settings</RootNamespace>
    <AssemblyName>DashMaid.Settings</AssemblyName>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and self-contained: no MSIX, no Store, no runtime installer. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Makes "dotnet publish" include the resource index (.pri) with the compiled XAML. Without it, the published app does not start. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- "dotnet publish" compiles the window to native code. "dotnet build" (the CMake target) uses the JIT. -->
    <PublishAot>true</PublishAot>
    <!-- The source generators of LibraryImport and GeneratedComInterface make unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Assets/DashMaid.ico</ApplicationIcon>
    <!-- The toolbar starts the settings window from the "Settings" folder next to DashMaid.exe. -->
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\src\Toolbar\$(Configuration)\Settings\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../Assets/DashMaid.ico" Link="DashMaid.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinUI and its dependencies only. The Microsoft.WindowsAppSDK package also adds the AI, ML, Search, and Widgets components. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <!-- WinUI 2.3.9 asks for 2.1.8, which is not on NuGet. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

</Project>
